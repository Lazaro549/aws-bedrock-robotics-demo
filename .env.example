# AWS credentials (or use default credential chain / IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bedrock model ID (Claude 3.5 Sonnet or newer recommended)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional: override max tokens and temperature
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.2

# Optional: indicative USD prices per 1M tokens (for portfolio cost estimates)
BEDROCK_INPUT_PRICE_PER_1M=3.0
BEDROCK_OUTPUT_PRICE_PER_1M=15.0

# Pipeline behaviour
PIPELINE_MODE=mock
LOG_LEVEL=INFO

# Bridge: path to record incoming scenes as JSONL (empty to disable)
BRIDGE_RECORD_SCENES=logs/scenes.jsonl
